// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// أيام الدرس: سبت (saturday) / ثلاثاء (tuesday)
model Student {
  id        String   @id @default(cuid())
  name      String
  age       Int
  lessonDay String
  points    Int      @default(0)   // رصيد النقاط
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records Record[]
}

model Record {
  id           String   @id @default(cuid())
  studentId    String
  memorization String
  grade        String
  homework     String
  date         DateTime
  createdAt    DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([studentId])
}

// درس أسبوعي - يمكن أن يحتوي على عدة صور مع نصوص توضيحية
model Lesson {
  id        String        @id @default(cuid())
  lessonDay String        // "saturday" أو "tuesday"
  weekStart DateTime      // بداية الأسبوع (السبت)
  createdAt DateTime      @default(now())
  images   LessonImage[]

  @@unique([lessonDay, weekStart])
  @@index([weekStart])
}

// صورة واحدة من درس - مع نص توضيحي اختياري
model LessonImage {
  id        String   @id @default(cuid())
  lessonId  String
  imageUrl  String
  caption   String?  // نص توضيحي اختياري
  order     Int      @default(0)
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}
