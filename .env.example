# نسخ هذا الملف إلى .env وتعبئة القيم من Supabase
#
# 1. من Supabase → Settings → Database → Connection string
# 2. استبدل [YOUR-PASSWORD] بكلمة سر القاعدة (رمّز الرموز الخاصة مثل @ → %40)
#
DATABASE_URL=postgresql://postgres:[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# من Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
